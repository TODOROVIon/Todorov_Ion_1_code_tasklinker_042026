{% extends 'base.html.twig' %}

{% block title %}Liste des projets{% endblock %}

{% block main %}
        <header>
               <div id="current-user">
                  {% if app.user %}
                     <a href="{{ path('app_deconnexion') }}">
                        <div class="employee-avatar">
                           {{ app.user.initials }}
                        </div>
                     </a>
                  {% endif %}
               </div>
               <div id="title-page">
                  <h1>Gestion des droits d'accès</h1>
               </div>
            </header>
            <div id="content">
                {{ form_start(form) }}
                    {{ form_row(form.name) }}
                    {{ form_row(form.description) }}
                    {{ form_row(form.deadline) }}
                    {{ form_row(form.idStatus) }}
                    {{ form_row(form.idUser) }}

                    <br>
                    {% if is_granted('ROLE_CHEF_PROJET') %}
                        <a href="{{ path('app_project_tache_delete', {'id': tache.id}) }}" class="delete-task">Supprimer la tâche</a>
                    {% endif %}
                    <button class="button button-submit">Modifier</button>
                {{ form_end(form) }}             
            </div>

{% endblock %}
