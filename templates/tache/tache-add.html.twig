{% extends 'base.html.twig' %}

{% block title %}Liste des projets{% endblock %}

{% block main %}
        <header>
               <div id="current-user">
                  {% if app.user %}
                     <a href="{{ path('app_deconnexion') }}">
                        <div class="employee-avatar" title="{{ app.user.firstName }} {{ app.user.lastName }}">
                           {{ app.user.initials }}
                        </div>
                     </a>
                  {% endif %}
               </div>
               <div id="title-page">
                  <h1>Créer une tâche</h1>
               </div>
            </header>
            <div id="content">
               <div id="content">
                {{ form_start(form) }}
                    {{ form_row(form.name) }}
                    {{ form_row(form.description) }}
                    {{ form_row(form.deadline) }}
                    {{ form_row(form.idStatus) }}
                    {{ form_row(form.idUser) }}

                    <br>
                    <button class="button button-submit">Ajouter</button>
                {{ form_end(form) }}             
            </div>
            </div>
{% endblock %}