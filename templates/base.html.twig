<!DOCTYPE html>
<html lang="fr">
   <head>
      {% block head %}
         <meta charset="UTF-8">
         <meta name="viewport" content="width=device-width; initial-scale=1" />
         <title>{% block title %}Liste des projets - TaskLinker{% endblock %}</title>
         {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('css/style.css') }}"/>
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css"
               integrity="sha512-MV7K8+y+gLIBoVD59lQIYicR65iaqukzvf/nwasF0nqhPay5w/9lJmVM2hMDcnK1OnMGCdVK+iQrJ7lzPJQd1w=="
               crossorigin="anonymous" referrerpolicy="no-referrer" />
            <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet"/>
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
         {% endblock %}

         {% block javascripts %}
            <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
            <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
            <script src="{{ asset('js/select.js') }}"></script>
            <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
         {% endblock %}
      {% endblock %}
   </head>
   <body>
      {% block body %}
         <div id="main-container">
            <nav>
            {% block nav %}
               <a href="{{ path('app_home') }}" id="logo">
               <img src="{{ asset('img/logo.png') }}" alt="Logo TaskLinker" />
               </a>
               <ul id="main-menu">
                  <li class="{{ app.request.attributes.get('_route') starts with 'app_home' or app.request.attributes.get('_route') starts with
  'app_project' ? 'active' : '' }}">
                     <a href="{{ path('app_home') }}">
                     <i class="fa-solid fa-list-check"></i> Projets
                     </a>
                  </li>
                  <li class="{{ app.request.attributes.get('_route') starts with 'app_users' ? 'active' : '' }}">
                     <a href="{{ path('app_users_list') }}">
                        <i class="fa-regular fa-user"></i> Équipe
                     </a>
                  </li>
               </ul>
            {% if app.user %}
               <a href="{{ path('app_deconnexion') }}" class="avatar-deconnection" title="Se déconnecter">
                  <div class="mini-user">
                     {{ app.user.initials }}
                  </div>
               </a>
            {% endif %}
            {% endblock %}
            </nav>

            <main>
            {% block main %}
               
            {% endblock %}
            </main>
         </div>
      {% endblock %}
   </body>
</html>