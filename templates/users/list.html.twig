{% extends 'base.html.twig' %}

{% block title %}Liste des employés{% endblock %}

{% block content %}
         
         <div id="content">
               <table id="team-container">
                  <thead>
                     <tr>
                        <th>Prénom, Nom</th>
                        <th>Statut</th>
                        <th>Role</th>
                        <th>Actions</th>
                     </tr>
                  </thead>
                  <tbody>
                        {% for user in users %}
                     <tr>
                        <td>
                           <div class="employee-infos">
                              <div class="employee-avatar">
                                 {{ user.initials }}
                              </div>
                              <div class="employee-coords">
                                 <strong>{{ user.firstName }} {{ user.lastName }}</strong>
                                 <span>{{ user.email }}</span>
                              </div>
                           </div>
                        </td>
                        <td>{{ user.contractType }}</td>
                        <td>{{ user.accessLevel }}</td>
                        <td>
                           <div class="td-actions">
                              {% if is_granted('ROLE_ADMIN') %}
                                 <a class="button button-edit-team" href="{{ path('app_users_show', {'id': user.id}) }}">
                                    Éditer
                                 </a>
                                 <a class="delete-team" href="{{ path('app_users_delete', {'id': user.id}) }}">
                                    Supprimer
                                 </a>
                              {% elseif is_granted('ROLE_CHEF_PROJET') and user.accessLevel != 'Admin' %}
                                 <a class="button button-edit-team" href="{{ path('app_users_show', {'id': user.id}) }}">
                                    Éditer
                                 </a>
                                 <a class="delete-team" href="{{ path('app_users_delete', {'id': user.id}) }}">
                                    Supprimer
                                 </a>
                              {% endif %}
                           </div>
                        </td>
                     </tr>
                     {% endfor %}              
                  </tbody>
               </table>
            </div>
    {% endblock %}